<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do NOT send API or upload paths to React (they must hit the Node backend)
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
